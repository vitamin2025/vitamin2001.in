# Environment Variables Template
# Origin or origin+/api both work for platform admin (auth lives at /api/auth).
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_MAIN_DOMAIN=localhost:3000
NEXT_PUBLIC_PRODUCTION_DOMAIN=vitamin2001.in
NEXT_PUBLIC_SYSTEM_ORG_SLUG=system

# Resource & Process Optimization (for shared hosts like Hostinger with 120 process limit)
NEXT_TELEMETRY_DISABLED=1
UV_THREADPOOL_SIZE=2
NODE_OPTIONS="--max-old-space-size=512"
